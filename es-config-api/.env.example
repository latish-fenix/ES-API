# ---- network ----
# Port on the host (docker-compose maps it to the container's 8080)
API_PORT=8080

# ---- storage (S3 is the only data store) ----
STORAGE_BACKEND=s3
S3_BUCKET=fenix-es-config-api
S3_PREFIX=es-config-api/
AWS_REGION=us-west-2
# S3_SSE=aws:kms            # leave unset to use the bucket's default encryption

# ---- secrets: AWS Secrets Manager (every password, key and hash lives there) ----
# The API creates and updates these itself (EC2 role needs docs/iam-policy.json):
#   <prefix>app                 session signing key + first-admin password
#   <prefix>users/<email>       console password hashes
#   <prefix>clusters/<id>       Elasticsearch password / API key per cluster
SECRETS_BACKEND=aws
SECRETS_PREFIX=es-config-api/
# Secrets are created in AWS_REGION (or SECRETS_REGION). Secrets made before the move to
# us-west-2 are still read from the legacy region and move over the first time they change
# (old copy: 7-day recovery). Move the rest: python -m app.cli migrate-secrets --dry-run
SECRETS_LEGACY_REGION=us-east-1
# SECRETS_KMS_KEY_ID=arn:aws:kms:...   # optional customer-managed key for new secrets

# ---- clusters ----
# Clusters defined by hand (read-only in the console)
CLUSTERS_FILE=/app/config/clusters.yaml
# Clusters added in the console / admin API: connection details only (their passwords are
# in Secrets Manager). Stays on this server (./data on the host). Empty = adding clusters off.
MANAGED_CLUSTERS_FILE=/app/data/clusters.managed.yaml

# ---- sign-in ----
AUTH_MODE=password
# No SESSION_SECRET here: it is generated into <prefix>app on first start. (An old value
# found here is copied there once, so sessions survive; then delete the line.)
SESSION_HOURS=12
# Set to true once the API is served over HTTPS
COOKIE_SECURE=false
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Admin emails (comma-separated); always admins and cannot be deleted through the API
BOOTSTRAP_ADMINS=latish.madapada@fenixcommerce.com
# First password for the bootstrap admins: generated into <prefix>app (field
# bootstrapAdminPassword) on first start; read it in the AWS console, sign in, change it.

# ---- approvals and email (AWS SES) ----
# Changes by non-admins wait for an admin's approval. Admins (and the requester) are
# emailed from this verified SES address; leave empty to approve in the console only.
MAIL_FROM=fenix_int_product_alerts@fenixcommerce.com
# SES_REGION=us-west-2      # default AWS_REGION
# Address used in email links
PUBLIC_URL=http://172.0.58.49
APPROVAL_EXPIRY_DAYS=7

# ---- behaviour ----
LOCK_TTL_SECONDS=600

# ---- Elasticsearch credentials ----
# None here: store each cluster's password with
#   docker compose exec -it es-config-api python -m app.cli set-cluster-secret <cluster-id>
# (or add the cluster in the console, which does it for you).
