# ---- storage (S3 is the only data store) ----
STORAGE_BACKEND=s3
S3_BUCKET=fenix-es-config-api
S3_PREFIX=es-config-api/
AWS_REGION=us-east-1
# S3_SSE=aws:kms            # leave unset to use the bucket's default encryption

# ---- clusters ----
CLUSTERS_FILE=/app/config/clusters.yaml

# ---- sign-in ----
AUTH_MODE=password
# Random, 32+ characters; keep it secret. Changing it signs everyone out.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-from-openssl-rand
SESSION_HOURS=12
# Set to true once the API is served over HTTPS
COOKIE_SECURE=false
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Admin emails (comma-separated); always admins and cannot be deleted through the API
BOOTSTRAP_ADMINS=latish.madapada@fenixcommerce.com
# First password for the bootstrap admins; used only until they change it
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-first-login

# ---- behaviour ----
LOCK_TTL_SECONDS=600

# ---- Elasticsearch credentials (referenced from clusters.yaml) ----
ES_PROD_US_USER=config_api
ES_PROD_US_PASSWORD=change-me
ES_STAGING_API_KEY=change-me
